# ---------------------------------------------------------------------------
# AgriRAG local environment. Copy to .env and fill in ANTHROPIC_API_KEY.
#   cp .env.example .env
# Everything else has a working local default.
# ---------------------------------------------------------------------------

APP_ENV=local
LOG_LEVEL=INFO

# --- Neo4j (docker-compose service `neo4j`) --------------------------------
# NEO4J_URI is overridden to bolt://neo4j:7687 inside the api container.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=agrirag_dev_pw
NEO4J_DATABASE=neo4j

# --- LanceDB (embedded - a directory, not a service) -----------------------
LANCEDB_PATH=./data/lancedb
LANCEDB_TABLE=agri_chunks

# --- Embeddings (local ONNX via fastembed - no API key, no network) --------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- Portkey gateway [Phase 2] ---------------------------------------------
# Default: self-hosted OSS gateway container. Leave PORTKEY_API_KEY empty.
# To switch to the hosted control plane (traces + dashboard), set
# PORTKEY_API_KEY and point PORTKEY_BASE_URL at https://api.portkey.ai/v1
PORTKEY_BASE_URL=http://localhost:8787/v1
PORTKEY_API_KEY=
PORTKEY_CONFIG_APP=
PORTKEY_CONFIG_EVAL=

# --- LLM provider ----------------------------------------------------------
# "anthropic" (default) is what the measured evaluation baseline was produced
# with. "ollama" routes to a local model instead: free, offline, no account -
# but a 3B model on CPU, so answer quality and latency both suffer. "groq" is
# a free hosted alternative: a real API (no local compute, no timeout relief
# needed) serving open-weight models at no cost. See docs/portkey.md before
# comparing any numbers across providers.
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
LLM_MODEL_PRIMARY=claude-sonnet-5
LLM_MODEL_FALLBACK=claude-haiku-4-5-20251001

# Only used when LLM_PROVIDER=ollama. The gateway runs in Docker, so it reaches
# an Ollama on the host via host.docker.internal rather than localhost.
#   ollama pull llama3.2
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:latest

# Only used when LLM_PROVIDER=groq. Free key, no card: console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Provider-aware defaults. Leave these alone unless you are tuning for a
# specific model - each is chosen per provider and documented in docs/portkey.md.
#   LLM_TIMEOUT_SECONDS  0 = auto (anthropic 60s, ollama 300s)
#   MAX_CONTEXT_CHARS    0 = auto (anthropic unlimited, ollama 2200)
#   LLM_GRADING          auto | on | off  (auto = off for ollama; a question
#                        costs three LLM calls and a small local model cannot
#                        afford the third. Abstention is unaffected.)
LLM_TIMEOUT_SECONDS=0
MAX_CONTEXT_CHARS=0
LLM_GRADING=auto

# --- Agent threading ---
CHECKPOINT_DB=./data/checkpoints.sqlite

# --- Evaluation [Phase 5] --------------------------------------------------
# Optional. Unset => DeepEval runs fully locally, reports land in evals/reports/.
CONFIDENT_API_KEY=
